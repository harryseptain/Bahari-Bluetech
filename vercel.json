{
  "buildCommand": "node build-articles.js",
  "outputDirectory": ".",
  "installCommand": "npm install gray-matter marked",
  "framework": null,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/api/auth", "destination": "/api/auth.js" },
    { "source": "/api/callback", "destination": "/api/callback.js" },
    { "source": "/", "destination": "/index.html" }
  ]
}
